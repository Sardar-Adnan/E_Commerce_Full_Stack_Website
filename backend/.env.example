# Django
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For LOCAL DEVELOPMENT (Postgres running in this sandbox):
DATABASE_URL=postgres://leafbloom_dev:devpassword123@localhost:5432/leafbloom_db

# For PRODUCTION (Supabase) — replace DATABASE_URL above with your Supabase connection string, e.g.:
# DATABASE_URL=postgres://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# CORS - frontend URL(s) allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
